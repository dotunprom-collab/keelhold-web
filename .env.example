# Public site URL (canonical links, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://keelholdcapital.com

# Cloudflare Turnstile — required in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Enquiry routing — each falls back to ENQUIRY_TO_DEFAULT.
# ENQUIRY_TO_ADVISORY receives every enquiry sent from the Advisory page.
ENQUIRY_TO_DEFAULT=
ENQUIRY_TO_GENERAL=
ENQUIRY_TO_ADVISORY=
ENQUIRY_TO_SOFTWARE=
ENQUIRY_TO_PARTNERSHIP=
ENQUIRY_TO_INVESTMENT=

# Analytics (Plausible) — loaded only after "Accept analytics"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
